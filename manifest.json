{
  "manifest_version": 3,
  "name": "ReadMode",
  "version": "1.5.1",
  "description": "Safari 风格阅读模式，支持黑白皮肤、排版调节、隐藏正文图片、选取文字生成分享卡片和原文二维码。",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["shortcut.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "进入 / 退出阅读模式（aa / Alt+Shift+R）",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "toggle-reader": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "进入或退出阅读模式"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["reader.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
